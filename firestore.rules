rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.email == 'dark@casino.app'; }
    function isOwner(name) { return signedIn() && request.auth.token.email == name + '@casino.app'; }
    function validName(name) { return name.matches('^[a-z0-9_]{3,16}$'); }

    match /accounts/{name} {
      // pemain yang sudah login boleh melihat saldo (dipakai meja online & panel admin)
      allow read: if signedIn();

      // buat akun: hanya milik sendiri, saldo awal tetap. "dark" = admin (daftarkan duluan!)
      allow create: if isOwner(name) && validName(name)
        && request.resource.data.keys().hasOnly(['balance','mode','wins','losses'])
        && request.resource.data.wins == 0 && request.resource.data.losses == 0
        && (
          (name != 'dark' && request.resource.data.mode == 'normal' && request.resource.data.balance == 2000) ||
          (name == 'dark' && request.resource.data.mode == 'admin')
        );

      // ubah: pemilik hanya boleh ubah angka miliknya (mode tidak boleh berubah); admin boleh semua
      allow update: if isAdmin() || (
        isOwner(name)
        && request.resource.data.mode == resource.data.mode
        && request.resource.data.balance is number && request.resource.data.balance >= 0
        && request.resource.data.wins is number && request.resource.data.losses is number
      );

      // hapus: hanya admin
      allow delete: if isAdmin();
    }
  }
}
